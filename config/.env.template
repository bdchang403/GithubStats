# GitHub Personal Access Token (Required for private repos and higher rate limits)
GITHUB_TOKEN=your_pat_here

# GitHub Enterprise API URL (Optional, default: https://api.github.com)
# Example: https://github.company.com/api/v3
GITHUB_API_BASE_URL=https://api.github.com

# Target Repository (Optional override for single repo mode)
# GITHUB_REPO=owner/repo

# Max Pull Requests to Analyze Per Repository (Optional, default: 30)
# Capping this protects against 5,000 requests/hr rate limits on fresh runs.
# MAX_PRS_TO_ANALYZE=30
